# --- Browser-visible variables (safe to expose, VITE_ prefix only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ORIGIN=http://localhost:5173
# Display-only price shown on the landing page. The real price is always the
# Stripe Price object referenced by STRIPE_LIFETIME_PRICE_ID.
VITE_LIFETIME_PRICE_DISPLAY=$29

# --- Server-only variables (never use a VITE_ prefix for these) ---
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIFETIME_PRICE_ID=
APPLE_LIFETIME_PRODUCT_ID=ai_blocker_lifetime
