{
  "manifest_version": 3,
  "name": "Aegis Enforcer",
  "version": "2.3.3",
  "description": "Enforce your Aegis AI policy live in the browser. Choose a value — Focus, Child-safe, School exam — and AI services are blocked in real time.",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aegis Enforcer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
